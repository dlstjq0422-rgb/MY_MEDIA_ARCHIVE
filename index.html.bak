      studio: "Apple Original Films",
      tags: ["Sports", "Drama"],
      year: "2025",
      status: "FEATURED",
      summary: "레이싱 현장의 속도감이 살아 있는 스포츠 드라마"
    }
  };

  const filterDefs = [
    { key: 'ALL', label: 'ALL' },
    { key: 'Action', label: 'ACTION' },
    { key: 'Sci-Fi', label: 'SCI-FI' },
    { key: 'Superhero', label: 'SUPERHERO' },
    { key: 'Adventure', label: 'ADVENTURE' }
  ];

  function ensureStyle(){
    if(document.getElementById('trailer-style-v408')) return;
    const style = document.createElement('style');
    style.id = 'trailer-style-v408';
    style.textContent = `
      .trailer-topbar-v408{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin:18px 0 26px;}
      .trailer-stats-v408{display:flex;flex-wrap:wrap;gap:10px;}
      .trailer-stat-v408{padding:10px 14px;border-radius:999px;background:rgba(12,18,30,.78);border:1px solid rgba(120,154,255,.16);color:#dbe7ff;font-size:12px;letter-spacing:.08em;text-transform:uppercase;}
      .trailer-filters-v408{display:flex;flex-wrap:wrap;gap:10px;}
      .trailer-filter-v408{appearance:none;border:1px solid rgba(130,160,255,.18);background:rgba(255,255,255,.04);color:#b9c9ff;padding:10px 14px;border-radius:999px;font-weight:700;font-size:12px;letter-spacing:.06em;cursor:pointer;transition:.2s ease;}
      .trailer-filter-v408:hover{transform:translateY(-1px);border-color:rgba(130,160,255,.42);}
      .trailer-filter-v408.active{background:linear-gradient(135deg, rgba(88,120,255,.32), rgba(74,217,255,.18));border-color:rgba(130,160,255,.65);color:#ffffff;box-shadow:0 10px 24px rgba(6,10,22,.24);}
      .trailer-card-v152{position:relative;overflow:hidden;}
      .trailer-card-v152.is-hidden-v408{display:none;}
      .trailer-poster-v152 .poster-status-v408{position:absolute;top:12px;left:12px;z-index:4;padding:6px 10px;border-radius:999px;background:rgba(5,10,20,.82);border:1px solid rgba(136,164,255,.34);color:#eef3ff;font-size:11px;font-weight:800;letter-spacing:.08em;}
      .trailer-poster-v152 .poster-playhint-v408{position:absolute;bottom:14px;left:14px;z-index:4;padding:7px 11px;border-radius:999px;background:rgba(7,10,18,.78);color:#f4f7ff;font-size:11px;font-weight:700;letter-spacing:.08em;border:1px solid rgba(255,255,255,.12);}
      .trailer-card-copy-v408{display:flex;flex-direction:column;gap:10px;margin-top:12px;}
      .trailer-card-copy-v408 h2{margin:0;}
      .trailer-chip-row-v408{display:flex;flex-wrap:wrap;gap:8px;}
      .trailer-chip-v408{padding:6px 10px;border-radius:999px;background:rgba(255,255,255,.05);border:1px solid rgba(125,146,214,.12);font-size:11px;color:#bfd0ff;font-weight:700;letter-spacing:.05em;}
      .trailer-summary-v408{margin:0;color:#aab8dc;line-height:1.55;font-size:13px;min-height:40px;}
      .trailer-actions-v408{display:flex;gap:10px;align-items:center;margin-top:2px;}
      .trailer-youtube-link-v408{display:inline-flex;align-items:center;justify-content:center;min-width:108px;padding:11px 14px;border-radius:12px;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.10);color:#dbe7ff;font-weight:700;text-decoration:none;font-size:13px;transition:.2s ease;}
      .trailer-youtube-link-v408:hover{background:rgba(255,255,255,.08);transform:translateY(-1px);}
      @media (max-width: 768px){.trailer-topbar-v408{align-items:flex-start}.trailer-actions-v408{flex-direction:column;align-items:stretch}.trailer-youtube-link-v408,.trailer-open-v171{width:100%;}}
    `;
    document.head.appendChild(style);
  }

  function ensureTopbar(section){
    if(section.querySelector('.trailer-topbar-v408')) return;
    const topbar = document.createElement('div');
    topbar.className = 'trailer-topbar-v408';
    topbar.innerHTML = `
      <div class="trailer-stats-v408">
        <span class="trailer-stat-v408">6 TRAILERS</span>
        <span class="trailer-stat-v408">YOUTUBE SOURCE</span>
        <span class="trailer-stat-v408">FEATURED MOVIES</span>
      </div>
      <div class="trailer-filters-v408"></div>
    `;
    const filters = topbar.querySelector('.trailer-filters-v408');
    filterDefs.forEach((item, idx)=>{
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'trailer-filter-v408' + (idx === 0 ? ' active' : '');
      btn.dataset.filter = item.key;
      btn.textContent = item.label;
      filters.appendChild(btn);
    });
    const grid = section.querySelector('.trailer-grid-v152');
    if(grid) section.insertBefore(topbar, grid);
  }

  function enhanceCard(card){
    if(card.dataset.enhancedV408 === 'true') return;
    const title = card.querySelector('h2')?.textContent?.trim();
    const data = trailers[title];
    const poster = card.querySelector('.trailer-poster-v152');
    const openButton = card.querySelector('.trailer-open-v171');
    if(!title || !data || !poster || !openButton) return;

    card.dataset.enhancedV408 = 'true';
    card.dataset.filterTags = [data.studio, data.year, ...data.tags].join('|');

    if(!poster.querySelector('.poster-status-v408')){
      const status = document.createElement('span');
      status.className = 'poster-status-v408';
      status.textContent = data.status;
      poster.appendChild(status);
    }
    if(!poster.querySelector('.poster-playhint-v408')){
      const hint = document.createElement('span');
      hint.className = 'poster-playhint-v408';
      hint.textContent = 'PLAY TRAILER';
      poster.appendChild(hint);
    }

    const oldP = card.querySelector('p');
    if(oldP) oldP.remove();

    const existingCopy = card.querySelector('.trailer-card-copy-v408');
    if(existingCopy) existingCopy.remove();

    const copy = document.createElement('div');
    copy.className = 'trailer-card-copy-v408';

    const titleEl = card.querySelector('h2');
    const chipRow = document.createElement('div');
    chipRow.className = 'trailer-chip-row-v408';
    [data.studio, ...data.tags, data.year].forEach(value=>{
      const chip = document.createElement('span');
      chip.className = 'trailer-chip-v408';
      chip.textContent = value;
      chipRow.appendChild(chip);
    });

    const summary = document.createElement('p');
    summary.className = 'trailer-summary-v408';
    summary.textContent = data.summary;

    const actions = document.createElement('div');
    actions.className = 'trailer-actions-v408';
    const youtubeLink = document.createElement('a');
    youtubeLink.className = 'trailer-youtube-link-v408';
    youtubeLink.href = 'https://www.youtube.com/watch?v=' + data.youtubeId;
    youtubeLink.target = '_blank';
    youtubeLink.rel = 'noopener noreferrer';
    youtubeLink.textContent = 'YouTube 열기';

    if(openButton.parentElement !== actions){
      actions.appendChild(openButton);
    }
    actions.appendChild(youtubeLink);

    copy.appendChild(chipRow);
    copy.appendChild(summary);
    copy.appendChild(actions);

    if(titleEl && titleEl.nextSibling){
      titleEl.parentNode.insertBefore(copy, titleEl.nextSibling);
    }else if(titleEl){
      titleEl.parentNode.appendChild(copy);
    }
  }

  function applyFilter(filterKey){
    document.querySelectorAll('.trailer-card-v152').forEach(card=>{
      if(filterKey === 'ALL'){
        card.classList.remove('is-hidden-v408');
        return;
      }
      const hay = card.dataset.filterTags || '';
      card.classList.toggle('is-hidden-v408', !hay.includes(filterKey));
    });
    document.querySelectorAll('.trailer-filter-v408').forEach(btn=>{
      btn.classList.toggle('active', btn.dataset.filter === filterKey);
    });
  }

  function init(){
    ensureStyle();
    const section = document.querySelector('#trailer .trailer-real-v152');
    if(!section) return;
    ensureTopbar(section);
    document.querySelectorAll('.trailer-card-v152').forEach(enhanceCard);
    section.querySelectorAll('.trailer-filter-v408').forEach(btn=>{
      btn.addEventListener('click', function(){ applyFilter(this.dataset.filter); });
    });
    applyFilter('ALL');
  }

  if(document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
})();
</script>





<script>
// v414 live trailer feed stable cache
(function(){
const FEED=[
 {title:'Deadpool & Wolverine Official Trailer',videoId:'73_1biulkYk',channel:'Marvel',tag:'GLOBAL MOVIE'},
 {title:'Wicked Official Trailer',videoId:'6COmYeLsz4c',channel:'Universal',tag:'GLOBAL MOVIE'},
 {title:'Inside Out 2 Official Trailer',videoId:'LEjhY15eCx0',channel:'Pixar',tag:'ANIMATION'},
 {title:'Dune Part Two Official Trailer',videoId:'Way9Dexny3w',channel:'Warner Bros',tag:'SCI-FI'},
 {title:'The Batman Trailer',videoId:'mqqft2x_Aa4',channel:'DC',tag:'GLOBAL MOVIE'},
 {title:'Spider-Man No Way Home Trailer',videoId:'JfVOs4VSpmA',channel:'Sony',tag:'MARVEL'},
 {title:'오징어 게임 시즌2',videoId:'Ed1sGgHUo88',channel:'Netflix Korea',tag:'KR SERIES'},
 {title:'파묘 공식 예고편',videoId:'placeholder1',channel:'KOREA',tag:'KR MOVIE'},
 {title:'범죄도시4 공식 예고편',videoId:'placeholder2',channel:'KOREA',tag:'KR MOVIE'},
 {title:'무빙 공식 예고편',videoId:'placeholder3',channel:'Disney+',tag:'KR SERIES'},
 {title:'더 글로리 공식 예고편',videoId:'placeholder4',channel:'Netflix',tag:'KR SERIES'},
 {title:'흑백요리사 공식 예고편',videoId:'placeholder5',channel:'Netflix',tag:'KR VARIETY'},
 {title:'Interstellar Trailer',videoId:'zSWdZVtXT7E',channel:'Warner Bros',tag:'SCI-FI'},
 {title:'Inception Trailer',videoId:'YoHD9XEInc0',channel:'Warner Bros',tag:'SCI-FI'},
 {title:'John Wick Trailer',videoId:'C0BMx-qxsP4',channel:'Lionsgate',tag:'ACTION'},
 {title:'Frozen Trailer',videoId:'TbQm5doF_Uc',channel:'Disney',tag:'ANIMATION'},
 {title:'Toy Story Trailer',videoId:'KYz2wyBy3kc',channel:'Pixar',tag:'ANIMATION'}
];
let page=0;
let lastItems=[];
function render(){
 const grid=document.querySelector('.trailer-live-grid-v409');
 const status=document.querySelector('.trailer-live-status-v409');
 const time=document.querySelector('.trailer-live-time-v409');
 if(!grid)return;
 try{
  const start=(page++ * 3)%FEED.length;
  const items=[0,1,2,3,4,5].map(i=>FEED[(start+i)%FEED.length]);
  if(!items.length) throw new Error('empty');
  lastItems=items;
  localStorage.setItem('mma_live_feed_v414',JSON.stringify(items));
  draw(items);
  status.textContent='업데이트 완료 · 새로운 Trailer Feed 표시';
 }catch(e){
  const saved=JSON.parse(localStorage.getItem('mma_live_feed_v414')||'null');
  draw(saved||lastItems);
  status.textContent='갱신 실패 · 마지막 정상 Trailer 유지';
 }
 time.textContent='마지막 갱신: '+new Date().toLocaleString('ko-KR');
}
function draw(items){
 const grid=document.querySelector('.trailer-live-grid-v409');
 if(!grid||!items||!items.length)return;
 grid.innerHTML='';
 items.forEach(x=>{
  const c=document.createElement('article');
  c.className='trailer-live-card-v409';
  c.innerHTML=`<div class="trailer-live-poster-v409" data-video-id="${x.videoId}"><img src="https://img.youtube.com/vi/${x.videoId}/hqdefault.jpg"><span class="trailer-live-play-v409">▶</span></div><div class="trailer-live-copy-v409"><div class="trailer-live-badges-v409"><span class="trailer-live-badge-v409">${x.tag}</span><span class="trailer-live-badge-v409">${x.channel}</span></div><h3 class="trailer-live-title-v409">${x.title}</h3><div class="trailer-live-actions-v409"><button class="trailer-live-open-v409" data-video-id="${x.videoId}">바로 재생</button></div></div>`;
  grid.appendChild(c);
 });
 grid.querySelectorAll('[data-video-id]').forEach(e=>e.onclick=()=>{
  const p=document.getElementById('TRAILER_PLAYER_V214');
  const m=document.getElementById('TRAILER_MODAL_V214');
  if(p&&m){p.src='https://www.youtube.com/embed/'+e.dataset.videoId+'?autoplay=1';m.style.display='flex';}
 });
}
const style=document.createElement('style');
style.textContent='.trailer-live-play-v409{width:28px!important;height:28px!important;font-size:11px!important}.trailer-poster-v152.poster-image-v166 b{width:28px!important;height:28px!important;font-size:11px!important}';
document.head.appendChild(style);
window.addEventListener('load',()=>{
 const b=document.querySelector('.trailer-live-refresh-v409');
 if(b)b.onclick=()=>{
   render();
 };
 render();
 // 자동 갱신 실패/중복 호출로 성공 데이터가 사라지는 문제 방지
 const grid=document.querySelector('.trailer-live-grid-v409');
 const observer=new MutationObserver(()=>{
   if(grid && !grid.children.length){
     render();
   }
 });
 if(grid) observer.observe(grid,{childList:true});
});
})();
</script>




<script>
// v419 LIVE FEED final persistence guard
(function(){
 const KEY='mma_live_feed_v414';
 function protect(){
  const grid=document.querySelector('.trailer-live-grid-v409');
  if(!grid) return;
  const saved=localStorage.getItem(KEY);
  if(saved && !grid.children.length){
    try{
      const items=JSON.parse(saved);
      if(items && items.length){
        grid.dataset.lockedRestore='true';
        grid.innerHTML='';
        items.forEach(x=>{
          const c=document.createElement('article');
          c.className='trailer-live-card-v409';
          c.innerHTML=`<div class="trailer-live-poster-v409"><img src="https://img.youtube.com/vi/${x.videoId}/hqdefault.jpg"><span class="trailer-live-play-v409">▶</span></div><div class="trailer-live-copy-v409"><div class="trailer-live-badges-v409"><span class="trailer-live-badge-v409">${x.tag||'UPDATE'}</span><span class="trailer-live-badge-v409">${x.channel||'YouTube'}</span></div><h3 class="trailer-live-title-v409">${x.title}</h3></div>`;
          grid.appendChild(c);
        });
      }
    }catch(e){}
  }
 }
 window.addEventListener('load',()=>{
  protect();
  const grid=document.querySelector('.trailer-live-grid-v409');
  if(grid)new MutationObserver(()=>setTimeout(protect,50)).observe(grid,{childList:true});
 });
})();
</script>


<script>
// v420 LIVE FEED DOM lock - final guard
(function(){
(function(){
 let snapshot='';
 function save(){
   const grid=document.querySelector('.trailer-live-grid-v409');
   if(grid && grid.children.length) snapshot=grid.innerHTML;
 }
 function restore(){
   const grid=document.querySelector('.trailer-live-grid-v409');
   if(grid && !grid.children.length && snapshot){
     grid.innerHTML=snapshot;
   }
 }
 window.addEventListener('load',function(){
   setTimeout(save,1000);
   setTimeout(save,5000);
   const grid=document.querySelector('.trailer-live-grid-v409');
   if(grid){
     new MutationObserver(function(){
       if(grid.children.length) save();
       else restore();
     }).observe(grid,{childList:true});
   }
 });
})();
})();
</script>

