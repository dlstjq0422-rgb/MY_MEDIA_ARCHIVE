<script id="TRAILER_MODAL_CLEANUP_V251">
(function(){
  // Direct modal cleanup hook.
  // Keep existing UI/player structure.

  window.cleanupTrailerModalV251 = function(){
    const player = document.querySelector("video");

    if(player){
      try{
        player.pause();
        player.currentTime = 0;
        player.removeAttribute("src");
        player.load();
        player.remove();
      }catch(e){}
    }
  };

  document.addEventListener("click", function(e){
    const text = (e.target.textContent || "").trim();

    if(
      text.includes("닫기") ||
      e.target.classList.contains("close") ||
      e.target.classList.contains("modal-close")
    ){
      window.cleanupTrailerModalV251();
    }
  });
})();
</script>

<script id="TRAILER_CLOSE_FUNCTION_FIX_V252">
(function(){
  // Hook close flow instead of only searching for a player.
  // Existing modal/player UI is preserved.

  function cleanupActiveMedia(){
    document.querySelectorAll("video, audio").forEach(function(media){
      try{
        media.pause();
        media.currentTime = 0;
        media.muted = true;
        media.removeAttribute("src");
        media.load();
      }catch(e){}
    });
  }

  const originalCloseCandidates = [
    "closeTrailer",
    "closeModal",
    "closeTrailerModal"
  ];

  originalCloseCandidates.forEach(function(name){
    if(typeof window[name] === "function"){
      const original = window[name];
      window[name] = function(){
        cleanupActiveMedia();
        return original.apply(this, arguments);
      };
    }
  });

  document.addEventListener("click", function(e){
    const el = e.target.closest("button, .close, [data-close]");
    if(!el) return;

    const text = (el.textContent || "").trim();
    if(text.includes("닫기") || text.includes("×")){
      cleanupActiveMedia();
    }
  }, true);

})();
</script>

