<script>
// v406 YouTube thumbnail renderer - DOM image layer
(function(){
 const ids={
  "Avatar: Fire and Ash":"nb_fFj_0rq8",
  "Superman":"Ox8ZLF6cGM0",
  "Mission: Impossible":"kLzsazwBanE",
  "Fantastic Four":"pAsmrKyMqaA",
  "Jurassic World":"jan5CFWs9ic",
  "F1":"CT2_P2DZBR0"
 };
 function apply(){
  document.querySelectorAll('.trailer-card-v152').forEach(card=>{
   const title=card.querySelector('h2')?.textContent?.trim();
   const poster=card.querySelector('.poster-image-v166');
   const id=ids[title];
   if(!poster||!id||poster.querySelector('.youtube-thumb-v406')) return;
   const img=document.createElement('img');
   img.className='youtube-thumb-v406';
   img.src='https://img.youtube.com/vi/'+id+'/hqdefault.jpg';
   img.alt=title+' trailer thumbnail';
   img.loading='lazy';
   poster.prepend(img);
  });
 }
 const style=document.createElement('style');
 style.textContent='.youtube-thumb-v406{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}.poster-image-v166{position:relative!important;overflow:hidden}.poster-image-v166 b{z-index:3!important}';
 document.head.appendChild(style);
 if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',apply); else apply();
})();
</script>

<script>
// v407 thumbnail click -> youtube trailer playback
(function(){
 const ids={
  "Avatar: Fire and Ash":"nb_fFj_0rq8",
  "Superman":"Ox8ZLF6cGM0",
  "Mission: Impossible":"kLzsazwBanE",
  "Fantastic Four":"pAsmrKyMqaA",
  "Jurassic World":"jan5CFWs9ic",
  "F1":"CT2_P2DZBR0"
 };
 const player=()=>document.getElementById('TRAILER_PLAYER_V214');
 function play(title){
  const p=player();
  if(!p||!ids[title]) return;
  p.src='https://www.youtube.com/embed/'+ids[title]+'?autoplay=1';
  const modal=document.querySelector('.trailer-modal-v214') || document.getElementById('TRAILER_MODAL_V214');
  if(modal) modal.style.display='flex';
 }
 document.addEventListener('click',function(e){
  const poster=e.target.closest('.poster-image-v166');
  if(poster){
   const card=poster.closest('.trailer-card-v152');
   const title=card?.querySelector('h2')?.textContent?.trim();
   play(title);
  }
 });
})();
</script>

