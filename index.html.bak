<script id="TRAILER_YOUTUBE_NOCOOKIE_V223">
(function(){
 const player = document.getElementById("TRAILER_PLAYER_V214");
 if(!player) return;

 const trailerSources = {
   "Avatar: Fire and Ash": "",
   "Superman": "",
   "Mission: Impossible": ""
 };

 document.addEventListener("click", function(e){
   const btn = e.target.closest("button");
   if(!btn || !btn.textContent.includes("예고편 보기")) return;

   const card = btn.closest(".trailer-card-v152");
   const title = card?.querySelector("h2")?.textContent?.trim();

   if(trailerSources[title]){
     player.src =
       "https://www.youtube-nocookie.com/embed/" +
       trailerSources[title] +
       "?enablejsapi=1";
     player.setAttribute("allow",
       "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture");
     player.setAttribute("referrerpolicy",
       "strict-origin-when-cross-origin");
   }
 });
})();
</script>

<script id="TRAILER_INTERNAL_VIDEO_V224">
(function(){
 const player = document.getElementById("TRAILER_PLAYER_V214");

 const trailerFiles = {
   "Avatar: Fire and Ash": "assets/trailers/avatar.mp4",
   "Superman": "assets/trailers/superman.mp4",
   "Mission: Impossible": "assets/trailers/mission.mp4"
 };

 document.addEventListener("click", function(e){
   const btn = e.target.closest("button");
   if(!btn || !btn.textContent.includes("예고편 보기")) return;

   const card = btn.closest(".trailer-card-v152");
