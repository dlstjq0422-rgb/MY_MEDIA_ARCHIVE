<script id="TRAILER_PLAYER_OUTPUT_V237">
(function(){
  window.TRAILER_PLAYER_OUTPUT_V237 = {
    attach:function(player, source){
      if(!player || !source) return false;
      player.src = source;
      if(player.load) player.load();
      return true;
    },
    reset:function(player){
      if(!player) return;
      if(player.pause) player.pause();
      if(player.removeAttribute) player.removeAttribute("src");
      if(player.load) player.load();
    }
  };
})();
</script>

<script id="TRAILER_PLAYBACK_ENGINE_V238">
(function(){
  // KEEP:
  // Existing pages, modal, player UI and layout.
  // Playback engine layer only.

  window.TRAILER_PLAYBACK_ENGINE_V238 = {
    start:function(player, source){
      if(!player || !source){
        return {success:false, status:"missing_source"};
      }

      player.src = source;
      player.load?.();

      return {
        success:true,
        status:"loaded"
      };
    },

    stop:function(player){
      if(!player) return;

      player.pause?.();
      player.removeAttribute?.("src");
      player.load?.();

      return {
        success:true,
        status:"stopped"
      };
    }
  };
})();
</script>

