<body>
<div id="cinematic-background"></div>
<div id="cinematic-overlay"></div>

  <div class="bg-layer bg-a" aria-hidden="true"></div>
  <div class="bg-layer bg-b" aria-hidden="true"></div>
  <div class="cinema-grade" aria-hidden="true"></div>

  <header class="topbar">
    <button class="brand" data-page="home" aria-label="홈으로">🎬 <span>MY MEDIA ARCHIVE</span></button>
    <nav class="nav">
      <button class="nav-btn active" data-page="home">HOME</button>
      <button class="nav-btn" data-page="collection">COLLECTION</button>
      <button class="nav-btn" data-page="add">ADD</button>
      <button class="nav-btn" data-page="report">REPORT</button>
      <button class="nav-btn" data-page="trailer">TRAILER</button>
    

</nav>
  </header>

  <main class="shell">
    
<section id="trailer" class="page">
  <div class="trailer-real-v152">
    <h1>TRAILER</h1>
    <p>최신 영화 예고편 피드</p>

    
<div class="trailer-grid-v152">
<div class="trailer-card-v152"><div class="trailer-poster-v152 poster-image-v166 poster-visible-v391 poster-avatar-v403"><b>▶</b></div><h2>Avatar: Fire and Ash</h2><p><div class="movie-meta-v167"><span class="movie-tag-v167">Disney</span><span class="movie-tag-v167">Sci-Fi</span><span class="movie-tag-v167">2025</span></div></p><button class="trailer-open-v171">예고편 보기</button></div>
<div class="trailer-card-v152"><div class="trailer-poster-v152 poster-image-v166 poster-visible-v391 poster-superman-v403"><b>▶</b></div><h2>Superman</h2><p><div class="movie-meta-v167"><span class="movie-tag-v167">DC</span><span class="movie-tag-v167">Action</span><span class="movie-tag-v167">2025</span></div></p><button class="trailer-open-v171">예고편 보기</button></div>
<div class="trailer-card-v152"><div class="trailer-poster-v152 poster-image-v166 poster-visible-v391 poster-mi-v403"><b>▶</b></div><h2>Mission: Impossible</h2><p><div class="movie-meta-v167"><span class="movie-tag-v167">Action</span><span class="movie-tag-v167">Coming Soon</span></div></p><button class="trailer-open-v171">예고편 보기</button></div>
<div class="trailer-card-v152"><div class="trailer-poster-v152 poster-image-v166 poster-visible-v391 poster-ff-v403"><b>▶</b></div><h2>Fantastic Four</h2><p>Marvel · 2025</p><button class="trailer-open-v171">예고편 보기</button></div>
<div class="trailer-card-v152"><div class="trailer-poster-v152 poster-image-v166 poster-visible-v391 poster-jw-v403"><b>▶</b></div><h2>Jurassic World</h2><p>Adventure · 2025</p><button class="trailer-open-v171">예고편 보기</button></div>
<div class="trailer-card-v152"><div class="trailer-poster-v152 poster-image-v166 poster-visible-v391 poster-f1-v403"><b>▶</b></div><h2>F1</h2><p>Sports · Drama</p><button class="trailer-open-v171">예고편 보기</button></div>
</div>

</section>

<section id="home" class="page active">
      <div class="hero">
        <div class="hero-copy">
          <p class="eyebrow">PERSONAL OTT ARCHIVE</p>
          <h1>나만의 미디어 라이브러리</h1>
          <p class="hero-desc">영화 · 드라마 · 애니메이션의 기억과 취향이 쌓이는 공간</p>
          <div class="hero-actions">
            <button class="primary" data-page-jump="add">+ 작품 추가</button>
            <button class="secondary" data-page-jump="collection">컬렉션 보기</button>
          </div>
        </div>
      </div>

      <section class="home-strip">
        <div class="strip-head"><h2>최근 감상</h2><span>RECENTLY ADDED</span></div>
        <div id="recentRow" class="media-row"></div>

        <div class="home-actions">
          <button class="action-card primary" onclick="switchPage('add')">
            <span class="action-kicker">QUICK ACTION</span>
            <strong>새 작품 추가</strong>
            <em>방금 본 영화, 드라마, 애니메이션을 바로 기록</em>
          </button>
          <button class="action-card" onclick="switchPage('collection')">
            <span class="action-kicker">LIBRARY</span>
            <strong>컬렉션 보기</strong>
            <em>내가 저장한 작품과 리뷰를 한눈에 확인</em>
          </button>
          <button class="action-card" onclick="switchPage('report')">
            <span class="action-kicker">INSIGHT</span>
            <strong>리포트 보기</strong>
            <em>평점, 장르 분포, 감상 기록을 요약해서 보기</em>
          </button>
        </div>

        <section class="ott-row">
          <div class="row-head">
            <h3>바로 시작하기</h3>
            <span>MY MEDIA FLOW</span>
          </div>
          <div class="poster-strip">
            <button class="poster-card" onclick="switchPage('add')"><b>감상 기록</b><span>작품명 / 평점 / 후기 등록</span></button>
            <button class="poster-card" onclick="switchPage('collection')"><b>내 컬렉션</b><span>저장된 작품 모아보기</span></button>
            <button class="poster-card" onclick="switchPage('report')"><b>취향 리포트</b><span>장르와 평점 통계 확인</span></button>
            <button class="poster-card" onclick="switchPage('collection')"><b>즐겨찾기</b><span>인생작만 따로 관리</span></button>
          </div>
        </section>

        <section class="ott-row secondary-row">
          <div class="row-head">
            <h3>아카이브 포인트</h3>
            <span>PERSONAL OTT ARCHIVE</span>
          </div>
          <div class="info-grid">
            <div class="info-panel">
              <strong>영화</strong>
              <p>한 편씩 기록이 쌓이는 개인 시네마 아카이브</p>
            </div>
            <div class="info-panel">
              <strong>드라마</strong>
              <p>시리즈 감상 기록과 후기까지 깔끔하게 정리</p>
            </div>
            <div class="info-panel">
              <strong>애니메이션</strong>
              <p>장르별로 구분해서 취향을 한눈에 확인</p>
            </div>
          </div>
        </section>
    
      </section>

      <section class="home-grid">
        <article class="glass-panel">
          <div class="strip-head"><h2>인생작</h2><span>FAVORITES</span></div>
          <div id="favoriteList" class="compact-list"></div>
        </article>
        <article class="glass-panel">
          <div class="strip-head"><h2>한눈에 보기</h2><span>OVERVIEW</span></div>
          <div id="homeStats" class="stats-grid"></div>
        </article>
      </section>
    </section>

    <div id="collectionTools" class="collection-tools"></div>
<section id="collection" class="page">
      <div class="section-title"><p class="eyebrow">BROWSE LIBRARY</p><h1>COLLECTION</h1></div>
      <div class="toolbar glass-panel">
        <input id="searchInput" type="search" placeholder="작품명, 태그 검색">
        <select id="sortSelect"><option value="new">최신 등록순</option><option value="rating">평점순</option><option value="title">제목순</option></select>
        <button id="favoritesOnly" class="chip">★ 즐겨찾기</button>
      </div>
      <div id="genreFilters" class="filter-row"></div>
      <div id="collectionGrid" class="collection-grid"></div>
    </section>

    <section id="add" class="page">
      <div class="section-title"><p class="eyebrow">CREATE ENTRY</p><h1 id="formHeading">ADD CONTENT</h1></div>
      <div class="add-layout">
        <aside class="preview-card glass-panel">
          <div id="posterPreview" class="poster-preview"><span>🎬</span></div>
          <h2 id="previewTitle">새 작품</h2>
          <p id="previewMeta">장르 · ☆☆☆☆☆</p>
        </aside>
        <form id="mediaForm" class="form-card glass-panel">
          <input id="editIndex" type="hidden" value="">
          <label>작품명<input id="title" required placeholder="작품명을 입력하세요"></label>
          <div class="two-col">
            <label>장르<select id="genre"><option value="">선택</option><option>영화</option><option>드라마</option><option>애니메이션</option><option>일본 애니메이션 영화</option><option>시리즈</option><option>다큐멘터리</option><option>기타</option></select></label>
            <label>감상 날짜<input id="date" type="date"></label>
          </div>
          <label>평점<div id="ratingStars" class="rating-stars half-ui" role="group" aria-label="평점"><button type="button" data-rate="1">★</button><button type="button" data-rate="2">★</button><button type="button" data-rate="3">★</button><button type="button" data-rate="4">★</button><button type="button" data-rate="5">★</button></div><input id="rating" type="hidden" value="0"></label>
          <label>포스터 URL<input id="poster" placeholder="https://..."></label>
          <label>태그<input id="tag" placeholder="#인생작 #감성 #재관람"></label>
          <label>감상 후기<textarea id="review" placeholder="이 작품에 대한 감상을 남겨보세요"></textarea></label>
          <label class="favorite-check"><input id="favorite" type="checkbox"> <span>즐겨찾기로 저장</span></label>
          <div class="form-actions"><button class="primary" type="submit" id="saveBtn">저장하기</button><button class="secondary" type="button" id="resetBtn">초기화</button></div>
        </form>
      </div>
    </section>

    <section id="report"
 class="page">
      <div class="section-title"><p class="eyebrow">YOUR MEDIA INSIGHT</p><h1>REPORT</h1></div>
      <div id="reportCards" class="report-cards"></div>
      <div id="reportInsight" class="report-insight"></div>
<div id="recentReport" class="report-recent"></div>
<div id="tasteReport" class="report-taste"></div>
<div id="bestReport" class="report-best"></div>


<div id="genreReport" class="report-genre"></div>
<div id="yearReport" class="report-year"></div>
<div id="reportTimeline" class="report-timeline"></div>
          <div class="report-grid">
        <article class="glass-panel"><div class="strip-head"><h2>장르 분포</h2><span>GENRES</span></div><div id="genreBars" class="bars"></div></article>
        <article class="glass-panel"><div class="strip-head"><h2>데이터 관리</h2><span>BACKUP</span></div><div class="backup-actions"><button id="exportBtn" class="primary">JSON 내보내기</button><label class="secondary file-btn">JSON 불러오기<input id="importInput" type="file" accept="application/json"></label></div></article>
      </div>
    
<section class="glass-panel" id="mediaTimelinePanel">
  <div class="section-title" style="padding:0 0 20px;">
    <h2>MY MEDIA TIMELINE</h2>
  </div>
  <div id="mediaTimeline" class="taste-timeline"></div><div id="recentMediaHighlight" class="glass-panel" style="margin-top:18px;"></div>

<section id="genreAnalysisPanel" class="glass-panel report-analysis-panel">
  <h2>MY GENRE ANALYSIS</h2>
  <div id="genreAnalysisSummary" class="genre-analysis-summary">
          <div class="analysis-chip">TOP GENRE</div>
          <div class="analysis-chip">MOST WATCHED</div>
          <div class="analysis-chip">AVERAGE SCORE</div>
        </div>
        <div id="genreAnalysisCards" class="genre-analysis-cards"></div><div id="analysisInsightPanel" class="analysis-insight-panel"><strong>MY MEDIA INSIGHT</strong><p>기록이 쌓이면 나의 감상 패턴을 보여줍니다.</p></div><div id="genreAnalysisContent">
    아직 충분한 작품 기록이 없습니다.
  </div>
</section>
</section>
</section>
  </main>

  <dialog id="detailDialog" class="detail-dialog">
    <button id="closeDetail" class="dialog-close" aria-label="닫기">×</button>
    <div id="detailContent"></div>
  </dialog>

