<script id="TRAILER_PLAYER_V216">
(function(){
 const player = document.getElementById("TRAILER_PLAYER_V214");
 if(!player) return;

 const trailerData = {
   "Avatar: Fire and Ash": "",
   "Superman": "",
   "Mission: Impossible": ""
 };

 document.addEventListener("click", function(e){
   const btn = e.target.closest("button");
   if(!btn || !btn.textContent.includes("예고편 보기")) return;

   const card = btn.closest(".trailer-card-v152");
   const title = card?.querySelector("h2")?.textContent?.trim();

   if(trailerData[title]){
     player.src = trailerData[title];
   } else {
     player.src = "";
   }
 });
})();
</script>

