<script id="TRAILER_PLAYER_FIX_V248">
(function(){
  // KEEP:
  // Existing modal/player/layout.
  // Fix close behavior and playback cleanup only.

  function stopTrailerVideo(){
    const player = document.querySelector("video, #TRAILER_PLAYER_V214");

    if(!player) return;

    try{
      player.pause();
      player.currentTime = 0;
      player.removeAttribute("src");
      player.load();
    }catch(e){}
  }

  document.addEventListener("click", function(e){
    const target = e.target;

    if(
      target.matches(".close, .modal-close, [data-close], button") &&
      (target.textContent.includes("닫기") ||
       target.getAttribute("aria-label") === "close")
    ){
      stopTrailerVideo();
    }
  });

  window.stopTrailerVideoV248 = stopTrailerVideo;
})();
</script>

<script id="TRAILER_AUDIO_FIX_V249">
(function(){
  // Robust trailer shutdown.
  // Keep existing UI/modal/player.

  function forceStopTrailer(){
    const players = document.querySelectorAll("video, audio, iframe");

    players.forEach(function(p){
      try{
        if(p.tagName === "VIDEO" || p.tagName === "AUDIO"){
          p.pause();
          p.currentTime = 0;
          p.muted = true;
          p.removeAttribute("src");
          p.load();
        }

        if(p.tagName === "IFRAME"){
          p.src = "about:blank";
        }
      }catch(e){}
    });
  }

  const observer = new MutationObserver(function(){
    const modal = document.querySelector(".modal, .trailer-modal, [role='dialog']");

    if(modal && (modal.style.display === "none" || !document.body.contains(modal))){
      forceStopTrailer();
    }
  });

  observer.observe(document.body, {
    childList:true,
    subtree:true,
    attributes:true,
    attributeFilter:["style","class"]
  });

  window.forceStopTrailerV249 = forceStopTrailer;
})();
</script>

<script id="TRAILER_DIRECT_PLAYER_CONTROL_V250">
