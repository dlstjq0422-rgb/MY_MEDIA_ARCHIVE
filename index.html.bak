<style>
.poster-visible-v391{
position:relative;
display:flex;
align-items:flex-end;
justify-content:center;
padding-bottom:22px;
overflow:hidden;
background:
linear-gradient(to top,rgba(0,0,0,.85),rgba(20,20,35,.25)),
linear-gradient(135deg,#24324a,#08090f);
}
.poster-visible-v391 span{
position:relative;
z-index:2;
font-size:20px;
font-weight:700;
text-align:center;
padding:0 15px;
}
.poster-visible-v391 b{
position:absolute;
right:15px;
bottom:15px;
width:42px;
height:42px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
background:white;
color:#111;
font-style:normal;
}
</style>

