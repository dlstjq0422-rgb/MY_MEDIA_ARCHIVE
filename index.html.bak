<script id="TRAILER_PLAYER_BIND_V257">
(function(){
  // Keep v253 playback/close behavior.
  // Connect source binding result to existing player flow only.

  window.playBoundTrailerV257 = function(title){
    const result = window.bindTrailerSourceV256?.(title);

    if(!result || !result.success || !result.source){
      return {
        success:false,
        status:"source_unavailable"
      };
    }

    const player = document.querySelector("video");

    if(!player){
      return {
        success:false,
        status:"player_missing"
      };
    }

    player.src = result.source;
    player.load();

    const playResult = player.play?.();

    if(playResult && playResult.catch){
      playResult.catch(function(){});
    }

    return {
      success:true,
      status:"playing",
      title:title
    };
  };
})();
</script>

<script id="TRAILER_SOURCE_MAPPING_V258">
